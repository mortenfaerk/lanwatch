@inject Session Session

<div class="login">
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="wordmark"><b>LanWatch</b><span>cache &amp; DNS</span></div>
        <div>
            <h1>Crew sign-in</h1>
            <p class="secondary" style="margin-top:6px">Live view of the lancache and AdGuard for this event. Use the shared crew password.</p>
        </div>
        <label class="field">
            <span class="label">Crew password</span>
            <input class="input" type="password" autocomplete="current-password" @bind="_password" @bind:event="oninput"
                   aria-invalid="@(_error is not null ? "true" : "false")" aria-describedby="login-error" autofocus />
        </label>
        @if (_error is not null)
        {
            <p id="login-error" class="error-text" role="alert"><Icon Name="triangle-alert" /> @_error</p>
        }
        <button class="btn primary" type="submit" disabled="@(_busy || string.IsNullOrEmpty(_password))">
            <Icon Name="lock" /> @(_busy ? "Signing in…" : "Sign in")
        </button>
    </form>
</div>

@code {
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = await Session.LoginAsync(_password);
        _busy = false;
    }
}
