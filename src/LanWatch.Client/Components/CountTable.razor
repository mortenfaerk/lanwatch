@{
    var max = Rows.Count == 0 ? 1 : Math.Max(1, Rows.Max(r => r.Count));
}
<table class="manifest">
    <thead><tr><th>@Label</th><th style="width:35%"></th><th class="num">Count</th></tr></thead>
    <tbody>
        @if (Rows.Count == 0)
        {
            <tr><td colspan="3"><div class="empty"><b>Nothing yet.</b></div></td></tr>
        }
        @foreach (var r in Rows)
        {
            <tr>
                <td class="@(Mono ? "data" : "")">@r.Name</td>
                <td><div class="split"><span class="bar" style="width:@((r.Count * 100.0 / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div></td>
                <td class="num data">@Format.Count(r.Count)</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CountEntry> Rows { get; set; } = [];
    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public bool Mono { get; set; }
}
